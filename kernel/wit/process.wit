interface spawn {
  spawn: async func(
    path: string,
    args: list<string>,
    env: list<string>,
  ) -> result<own<spawn-handle>, string>;

  resource spawn-handle {
    terminate: async func();
  }
}

world process-only-spawn {
  import spawn;
}
